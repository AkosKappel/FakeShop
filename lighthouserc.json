{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec vite preview --port 4175 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4175/",
        "http://localhost:4175/products?q=phone",
        "http://localhost:4175/products/1",
        "http://localhost:4175/cart",
        "http://localhost:4175/about"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
